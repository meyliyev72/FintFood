# FintFood frontend — example environment (commit this file)
# Copy to `.env.local` and fill in real values.

# --- API ---------------------------------------------------------------------
# Base URL of the Django REST API, without a trailing slash.
# Used by the browser and by React Server Components during SSR/ISR.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only API URL. React Server Components fetch from inside the
# Render network, where the internal hostname is reachable and CORS does not
# apply. Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:8000

# Host + port that serves /media (recipe, category and step images).
# next.config.ts whitelists it for next/image and proxies /media/* to it.
NEXT_PUBLIC_MEDIA_HOST=localhost
NEXT_PUBLIC_MEDIA_PORT=8000

# --- Site --------------------------------------------------------------------
# Public origin, used for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
