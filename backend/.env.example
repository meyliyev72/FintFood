# FintFood backend — example environment (commit this file)
# Copy to `.env` and fill in real values.

# --- Django core -----------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL ------------------------------------------------------------
DATABASE_NAME=fintfood
DATABASE_USER=fintfood
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5434

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
JWT_SECURE_COOKIES=false

# --- CORS / frontend -------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Email -----------------------------------------------------------------
# Dev: django.core.mail.backends.console.EmailBackend prints to stdout.
# Prod (SMTP example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=***
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=FintFood <no-reply@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend